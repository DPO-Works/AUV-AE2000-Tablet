<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textSize="24.0sp"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="10dp"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".subpayload"
    android:background="#ffd9dbff">
    <!---
    android:background="@drawable/top2" >
    -->
<!-- Payload Settings -->
    <TextView
        android:layout_width="940dip"
        android:layout_height="30dip"
        android:text="Payload Settings"
        android:id="@+id/pld_tvSettingTitle"
        android:textSize="24dp"
        android:background="#99fff957"
        android:layout_marginLeft="0dp" />


    <TextView
        android:layout_width="300dip"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Payload Task"
        android:id="@+id/pld_tvPayA"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="20dp"
        />

    <Button
        android:layout_width="200dip"
        android:layout_height="50dip"
        android:text="Payload ON"
        android:id="@+id/pld_btPayloadOn"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="40dp"
        />

    <Button
        android:layout_width="200dip"
        android:layout_height="50dip"
        android:text="Payload OFF"
        android:id="@+id/pld_btPayloadOff"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="260dp"
        />

<!-- Payload Start/Stop -->

    <Button
        android:layout_width="200dip"
        android:layout_height="50dip"
        android:text="REC START"
        android:id="@+id/pld_btPayloadRecStart"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="120dp"
        android:layout_marginLeft="40dp"
        />

    <Button
        android:layout_width="200dip"
        android:layout_height="50dip"
        android:text="REC STOP"
        android:id="@+id/pld_btPayloadRecStop"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="120dp"
        android:layout_marginLeft="260dp"
        />

    <Button
        android:layout_width="200dip"
        android:layout_height="50dip"
        android:text="CALB START"
        android:id="@+id/pld_btPayloadCalbStart"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="120dp"
        android:layout_marginLeft="480dp"
        />

    <Button
        android:layout_width="200dip"
        android:layout_height="50dip"
        android:text="CALB STOP"
        android:id="@+id/pld_btPayloadCalbStop"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="120dp"
        android:layout_marginLeft="700dp"
        />



<!-- Payload Data -->

    <TextView
        android:layout_width="300dip"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Task Data"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:layout_marginTop="180dp"
        android:layout_marginLeft="20dp"
        />

<!-- TaskStatus -->
    <TextView
        android:layout_width="200dip"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Task Status"
			android:background="@drawable/border"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:layout_marginTop="210dp"
        android:layout_marginLeft="40dp"
        />

    <TextView
        android:layout_width="100dip"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text=""
			android:background="@drawable/border"
        android:id="@+id/pld_tvPldTaskStatus"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:layout_marginTop="210dp"
        android:layout_marginLeft="240dp"
        />

<!-- TaskError -->
    <TextView
        android:layout_width="200dip"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Task Error"
			android:background="@drawable/border"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:layout_marginTop="240dp"
        android:layout_marginLeft="40dp"
        />

    <Button
        android:layout_width="100dip"
        android:layout_height="30dip"
        android:textSize="14.0sp"
        android:background="@drawable/button_r"
        android:text="----"
        android:id="@+id/pld_btPldTaskError"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:textAllCaps="false"
        android:layout_marginTop="240dp"
        android:layout_marginLeft="240dp"
        />

<!-- Payload Status -->
    <TextView
        android:layout_width="200dip"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Task Status"
			android:background="@drawable/border"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:layout_marginTop="270dp"
        android:layout_marginLeft="40dp"
        />
    <TextView
        android:layout_width="400dip"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text=""
			android:background="@drawable/border"
        android:id="@+id/pld_tvPldStatus"
        android:layout_below="@+id/pld_tvSettingTitle"
        android:layout_marginTop="270dp"
        android:layout_marginLeft="240dp"
        />

<!-- Mark Status -->

    <Button
        android:layout_width="200dip"
        android:layout_height="50dip"
        android:text="Ready Mark"
        android:id="@+id/pld_btPayloadCheck"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="640dp"
        android:layout_marginLeft="20dp"

        />

</RelativeLayout>
