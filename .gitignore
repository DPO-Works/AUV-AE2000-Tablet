```gitignore
# Gradle
.gradle/
build/
**/build/

# Local configuration
local.properties

# Android Studio / IntelliJ
.idea/
*.iml

# Generated / temporary files
captures/
.externalNativeBuild/
.cxx/

# App Bundle
*.aab

# Keystore / signing files
*.jks
*.keystore

# OS files
.DS_Store
Thumbs.db

# Logs / temp
*.log
*.tmp
*.swp
```